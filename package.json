{
  "name": "purge-whatsapp-padel",
  "version": "0.1.0",
  "private": true,
  "description": "Annecy Tennis : rapproche le groupe WhatsApp padel de la liste des adhérents Adoc et retire, après validation, les membres qui n'ont pas renouvelé.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "adoc:connexion": "node src/adoc/login.js",
    "adoc:export": "node src/adoc/export.js",
    "wa:connexion": "node src/whatsapp/login.js",
    "wa:membres": "node src/whatsapp/members.js",
    "rapport": "node src/report/run.js",
    "preparer": "node src/adoc/export.js && node src/whatsapp/members.js && node src/report/run.js",
    "wa:retirer": "node src/whatsapp/remove.js",
    "nettoyer": "node src/cleanup.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "playwright": "^1.56.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
